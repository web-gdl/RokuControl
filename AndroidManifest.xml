<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.rokuremote"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- Los sockets de Android exigen este permiso incluso para la red local. La app solo abre
         conexiones a IPv4 privadas (validado en Hosts) y no contiene ningún destino externo. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Elegir la red Wi-Fi/Ethernet aunque haya datos móviles activos. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recibir las respuestas SSDP de los Roku al buscarlos. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="app.rokuremote.ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
